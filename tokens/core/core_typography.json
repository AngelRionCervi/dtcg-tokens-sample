{
  "fontFamilies": {
    "arial": {
      "$type": "fontFamily",
      "$value": "Arial, sans-serif"
    },
    "helvetica": {
      "$type": "fontFamily",
      "$value": ["Helvetica", "Arial", "sans-serif"]
    },
    "inter": {
      "$type": "fontFamily",
      "$value": ["Inter", "Arial", "sans-serif"]
    }
  },
  "fontSizes": {
    "100": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "200": {
      "$type": "dimension",
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "300": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "400": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "800": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "1200": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    }
  },
  "fontWeights": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "bold": {
      "$type": "fontWeight",
      "$value": "bold"
    },
    "thin": {
      "$type": "fontWeight",
      "$value": 100
    }
  },
  "lineHeights": {
    "normal": {
      "$type": "number",
      "$value": 1.5
    },
    "loose": {
      "$type": "number",
      "$value": 2
    },
    "tight": {
      "$type": "number",
      "$value": 1.25
    }
  },
  "letterSpacings": {
    "normal": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "wide": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "superWide": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    }
  }
}
