{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Example Design System",
  "version": "2025.10",
  "resolutionOrder": [
    {
      "$ref": "#/sets/core"
    },
    {
      "$ref": "#/sets/common"
    },
    {
      "$ref": "#/modifiers/color-mode"
    },
    {
      "$ref": "#/modifiers/size-mode"
    }
  ],
  "sets": {
    "core": {
      "sources": [
        {
          "$ref": "./core/core_color.json"
        },
        {
          "$ref": "./core/core_dimension.json"
        }
      ]
    },
    "common": {
      "sources": [
        {
          "$ref": "./common.json"
        }
      ]
    }
  },
  "modifiers": {
    "color-mode": {
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "./mode-color/light.json"
          }
        ],
        "dark": [
          {
            "$ref": "./mode-color/dark.json"
          }
        ]
      }
    },
    "size-mode": {
      "default": "md",
      "contexts": {
        "xs": [
          {
            "$ref": "#/sets/common"
          },
          {
            "$ref": "./mode-size/xs/size.json"
          }
        ],
        "md": [
          {
            "$ref": "#/sets/common"
          },
          {
            "$ref": "./mode-size/md/size.json"
          }
        ],
        "xl": [
          {
            "$ref": "#/sets/common"
          },
          {
            "$ref": "./mode-size/xl/size.json"
          }
        ]
      }
    }
  }
}
