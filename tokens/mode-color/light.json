{
  "semantic": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.gray100}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "textSecondary": {
        "$type": "color",
        "$value": "{color.gray700}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.gray300}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.blue500}"
      }
    }
  },
  "semanticGradients": {
    "semantic-example": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [1, 0, 1]
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [1, 0, 0]
          },
          "position": 0.5
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.4, 0, 1]
          },
          "position": 1
        }
      ],
      "$extensions": {
        "com.studio-token": {
          "gradient": {
            "type": "GRADIENT_RADIAL",
            "angle": 30
          }
        }
      }
    },
    "semantic-example-2": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [1, 1, 0]
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 1, 1]
          },
          "position": 0.7
        },
        {
          "color": "{color.gray100}",
          "position": 1
        }
      ],
      "$extensions": {
        "com.studio-token": {
          "gradient": {
            "type": "GRADIENT_LINEAR",
            "angle": 45
          }
        }
      }
    }
  }
}
