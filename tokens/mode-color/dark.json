{
  "semantic": {
    "color": {
      "background": {
        "$type": "color",
        "$value": "{color.black}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.gray900}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "textSecondary": {
        "$type": "color",
        "$value": "{color.gray300}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.gray700}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.blue500}"
      }
    }
  },
  "semanticGradients": {
    "semantic-example": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.3, 1, 1]
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [1, 0.7, 0.3]
          },
          "position": 0.5
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.4, 1, 1]
          },
          "position": 1
        }
      ],
      "$extensions": {
        "com.studio-token": {
          "gradient": {
            "type": "GRADIENT_RADIAL",
            "angle": 30
          }
        }
      }
    },
    "semantic-example-2": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.3, 0.7, 0.3]
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.3, 0.6, 1]
          },
          "position": 0.7
        },
        {
          "color": "{color.gray300}",
          "position": 1
        }
      ],
      "$extensions": {
        "com.studio-token": {
          "gradient": {
            "type": "GRADIENT_DIAMOND",
            "angle": 45
          }
        }
      }
    }
  },
  "semanticShadows": {
    "semantic-example-shadow": {
      "$type": "shadow",
      "$value": {
        "color": "{color.white}",
        "offsetX": "{dimension.space100}",
        "offsetY": "{dimension.space200}",
        "blur": "{dimension.space200}",
        "spread": "{dimension.space200}"
      }
    }
  }
}
